NODE_ENV=development
PORT=5000
PUBLIC_API_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

MONGO_URI=mongodb://localhost:27017/paleo?replicaSet=rs0
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-64-character-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=paleo_token

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=PaleoMarketBot
TELEGRAM_WEBHOOK_SECRET=
ALLOW_TELEGRAM_ADMIN_BOOTSTRAP=false

# Chapa (Ethiopian Payment Gateway)
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
BUYER_STORE_URL=http://localhost:3000

# Cloudflare Turnstile & Sentry Monitoring
CLOUDFLARE_TURNSTILE_SECRET_KEY=
SENTRY_DSN=

# Optional Cloudinary Tier
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Routing (Mapbox Managed Alternative)
MAPBOX_ACCESS_TOKEN=

OCR_SERVICE_URL=http://localhost:8000/parse-receipt
OCR_TIMEOUT_MS=12000

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=paleo-marketplace
R2_PUBLIC_BASE_URL=https://media.paleo.market
MAX_FILE_SIZE_BYTES=10485760

TYPESENSE_PROTOCOL=http
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=replace-before-production
TYPESENSE_TIMEOUT_MS=6000

OSRM_ENDPOINT=https://router.project-osrm.org/route/v1/driving
OSRM_TIMEOUT_MS=10000

DEFAULT_PLATFORM_FEE_RATE=0.025
COURIER_WEBHOOK_SECRET=replace-with-courier-shared-secret
SEED_DEMO_DATA=false
