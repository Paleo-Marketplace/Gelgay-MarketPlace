upstream paleo_api { server 127.0.0.1:5000; keepalive 32; }
upstream paleo_buyer { server 127.0.0.1:3000; keepalive 16; }
upstream paleo_vendor { server 127.0.0.1:5173; keepalive 16; }
upstream paleo_admin { server 127.0.0.1:5174; keepalive 16; }
upstream paleo_courier { server 127.0.0.1:5175; keepalive 16; }

limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;

server {
  listen 80;
  server_name ${PALEO_DOMAIN};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name ${PALEO_DOMAIN};
  client_max_body_size 10m;

  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  location /api/auth/ {
    limit_req zone=auth_limit burst=10 nodelay;
    proxy_pass http://paleo_api;
    include /etc/nginx/proxy_params;
  }

  location /api/ {
    limit_req zone=api_limit burst=40 nodelay;
    proxy_pass http://paleo_api;
    include /etc/nginx/proxy_params;
  }

  location /socket.io/ {
    proxy_pass http://paleo_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 65s;
  }

  location /vendor/ { proxy_pass http://paleo_vendor/; include /etc/nginx/proxy_params; }
  location /admin/ { proxy_pass http://paleo_admin/; include /etc/nginx/proxy_params; }
  location /courier/ { proxy_pass http://paleo_courier/; include /etc/nginx/proxy_params; }
  location / { proxy_pass http://paleo_buyer; include /etc/nginx/proxy_params; }
}
